# .env.local - Environment variables for docker-compose.local.yml
# Copy to .env and customize

# WeKan version to build (matches GitHub release tag)
WEKAN_VERSION=10.37

# =========================================================================
# REQUIRED: Change these for production
# =========================================================================
# Your public URL (must match browser address)
ROOT_URL=http://localhost

# Email configuration (required for invitations, password reset)
MAIL_URL=smtp://user:pass@mail.example.com:587/?ignoreTLS=true&tls={rejectUnauthorized:false}
MAIL_FROM=Wekan <noreply@your-domain.com>

# =========================================================================
# OPTIONAL: File storage (S3-compatible)
# =========================================================================
# S3='{"s3":{"key": "AKIA...", "secret": "xxx", "bucket": "wekan-files", "region": "us-east-1"}}'

# =========================================================================
# OPTIONAL: OAuth2 / OIDC
# =========================================================================
# OAUTH2_ENABLED=true
# OAUTH2_CLIENT_ID=xxx
# OAUTH2_SECRET=xxx
# OAUTH2_SERVER_URL=https://auth.example.com
# OAUTH2_AUTH_ENDPOINT=/oauth2/authorize
# OAUTH2_TOKEN_ENDPOINT=/oauth2/token
# OAUTH2_USERINFO_ENDPOINT=/oauth2/userinfo
# OAUTH2_ID_MAP=sub
# OAUTH2_USERNAME_MAP=preferred_username
# OAUTH2_EMAIL_MAP=email
# OAUTH2_FULLNAME_MAP=name

# =========================================================================
# OPTIONAL: LDAP
# =========================================================================
# LDAP_ENABLE=true
# LDAP_HOST=ldap.example.com
# LDAP_PORT=389
# LDAP_BASEDN=ou=users,dc=example,dc=com
# LDAP_USER_SEARCH_FIELD=uid
# LDAP_AUTHENTIFICATION=true
# LDAP_AUTHENTIFICATION_USERDN=cn=admin,dc=example,dc=com
# LDAP_AUTHENTIFICATION_PASSWORD=xxx

# =========================================================================
# OPTIONAL: CORS
# =========================================================================
# CORS=*
# CORS_ALLOW_HEADERS=Authorization,Content-Type

# =========================================================================
# OPTIONAL: Monitoring / Analytics
# =========================================================================
# MATOMO_ADDRESS=https://matomo.example.com
# MATOMO_SITE_ID=1
# METRICS_ALLOWED_IP_ADDRESSES=192.168.1.0/24